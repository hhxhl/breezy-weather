<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/BreezyWeatherAndroidSWidget">

    <!-- Keep the card independent from the forecast so transparency does not fade text/icons. -->
    <ImageView
        android:id="@+id/widget_split_forecast_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_m3_background"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="10dp">

    <!-- Left: compact vertical summary, using the same original weather/subtitle views. -->
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="2.65" android:gravity="center_vertical" android:orientation="vertical"
        android:paddingStart="5dp" android:paddingEnd="7dp">
        <!-- City -->
        <TextView android:id="@+id/widget_material_you_forecast_city"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="13sp" android:textStyle="normal" android:maxLines="1"
            android:ellipsize="end" android:text="@string/widget_ellipsis" />
        <!-- Current weather: icon on the left, temperature above condition on the right.
             Keep the row's minimum height near the previous two-row block to avoid
             shifting the city, AQI and divider at the default text size. -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="65dp" android:orientation="horizontal"
            android:gravity="center_vertical" android:layout_marginTop="1dp">
            <ImageView android:id="@+id/widget_material_you_forecast_currentIcon"
                android:layout_width="48dp" android:layout_height="48dp"
                android:src="@drawable/weather_cloudy" android:contentDescription="@null" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:gravity="center" android:layout_marginStart="3dp">
                <TextView android:id="@+id/widget_material_you_forecast_currentTemperature"
                    android:layout_width="match_parent" android:layout_height="44dp"
                    android:text="@string/widget_ellipsis" android:textColor="?android:attr/textColorPrimary"
                    android:textSize="32sp" android:fontFamily="sans-serif-condensed-light"
                    android:textStyle="normal" android:includeFontPadding="false"
                    android:gravity="center"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="20sp"
                    android:autoSizeMaxTextSize="32sp"
                    android:autoSizeStepGranularity="1sp"
                    android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/widget_material_you_forecast_weatherText"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorSecondary" android:textSize="12sp"
                    android:fontFamily="sans-serif" android:textStyle="normal"
                    android:gravity="center_horizontal"
                    android:maxLines="1" android:ellipsize="end"
                    android:text="@string/widget_ellipsis" />
            </LinearLayout>
        </LinearLayout>
        <!-- Air quality: hide completely when the provider has no AQI. -->
        <TextView android:id="@+id/widget_split_forecast_air_quality"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" android:maxLines="1" android:ellipsize="end"
            android:visibility="gone" />
        <TextView android:layout_width="match_parent" android:layout_height="1dp"
            android:background="?android:attr/textColorSecondary" android:alpha="0.18"
            android:layout_marginTop="7dp" android:layout_marginBottom="7dp" />
        <!-- Date + the existing user-configurable subtitle. -->
        <TextView android:id="@+id/widget_split_forecast_date"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorSecondary" android:textSize="12sp"
            android:fontFamily="sans-serif" android:textStyle="normal"
            android:maxLines="1" android:ellipsize="end" android:text="@string/widget_ellipsis" />
        <TextView android:id="@+id/widget_split_forecast_subtitle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" android:fontFamily="sans-serif" android:textStyle="normal"
            android:maxLines="1" android:ellipsize="end" android:text="@string/widget_ellipsis" />
    </LinearLayout>

    <TextView android:layout_width="1dp" android:layout_height="match_parent"
        android:background="?android:attr/textColorSecondary" android:alpha="0.3" />

    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="5.35" android:orientation="vertical" android:paddingStart="6dp">
        <!-- Upper right: 5 hourly forecasts -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/widget_material_you_forecast_hour_1"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="?android:attr/textColorPrimary" android:gravity="center"
                    android:maxLines="1" android:ellipsize="end" android:text="@string/widget_ellipsis" />
                <ImageView android:id="@+id/widget_material_you_forecast_hourlyIcon_1"
                    android:layout_width="22dp" android:layout_height="22dp"
                    android:layout_marginTop="7dp" android:layout_marginBottom="7dp"
                    android:src="@drawable/weather_cloudy" />
                <TextView android:id="@+id/widget_material_you_forecast_hourlyTemperature_1"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed-light"
                    android:textSize="13sp" android:textColor="?android:attr/textColorPrimary" android:gravity="center"
                    android:maxLines="1" android:ellipsize="end" android:text="@string/widget_ellipsis" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/widget_material_you_forecast_hour_2"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="?android:attr/textColorPrimary" android:gravity="center"
                    android:maxLines="1" android:ellipsize="end" android:text="@string/widget_ellipsis" />
                <ImageView android:id="@+id/widget_material_you_forecast_hourlyIcon_2"
                    android:layout_width="22dp" android:layout_height="22dp"
                    android:layout_marginTop="7dp" android:layout_marginBottom="7dp"
                    android:src="@drawable/weather_cloudy" />
                <TextView android:id="@+id/widget_material_you_forecast_hourlyTemperature_2"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed-light"
                    android:textSize="13sp" android:textColor="?android:attr/textColorPrimary" android:gravity="center"
                    android:maxLines="1" android:ellipsize="end" android:text="@string/widget_ellipsis" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/widget_material_you_forecast_hour_3"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="?android:attr/textColorPrimary" android:gravity="center"
                    android:maxLines="1" android:ellipsize="end" android:text="@string/widget_ellipsis" />
                <ImageView android:id="@+id/widget_material_you_forecast_hourlyIcon_3"
                    android:layout_width="22dp" android:layout_height="22dp"
                    android:layout_marginTop="7dp" android:layout_marginBottom="7dp"
                    android:src="@drawable/weather_cloudy" />
                <TextView android:id="@+id/widget_material_you_forecast_hourlyTemperature_3"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed-light"
                    android:textSize="13sp" android:textColor="?android:attr/textColorPrimary" android:gravity="center"
                    android:maxLines="1" android:ellipsize="end" android:text="@string/widget_ellipsis" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/widget_material_you_forecast_hour_4"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="?android:attr/textColorPrimary" android:gravity="center"
                    android:maxLines="1" android:ellipsize="end" android:text="@string/widget_ellipsis" />
                <ImageView android:id="@+id/widget_material_you_forecast_hourlyIcon_4"
                    android:layout_width="22dp" android:layout_height="22dp"
                    android:layout_marginTop="7dp" android:layout_marginBottom="7dp"
                    android:src="@drawable/weather_cloudy" />
                <TextView android:id="@+id/widget_material_you_forecast_hourlyTemperature_4"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed-light"
                    android:textSize="13sp" android:textColor="?android:attr/textColorPrimary" android:gravity="center"
                    android:maxLines="1" android:ellipsize="end" android:text="@string/widget_ellipsis" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/widget_material_you_forecast_hour_5"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="?android:attr/textColorPrimary" android:gravity="center"
                    android:maxLines="1" android:ellipsize="end" android:text="@string/widget_ellipsis" />
                <ImageView android:id="@+id/widget_material_you_forecast_hourlyIcon_5"
                    android:layout_width="22dp" android:layout_height="22dp"
                    android:layout_marginTop="7dp" android:layout_marginBottom="7dp"
                    android:src="@drawable/weather_cloudy" />
                <TextView android:id="@+id/widget_material_you_forecast_hourlyTemperature_5"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed-light"
                    android:textSize="13sp" android:textColor="?android:attr/textColorPrimary" android:gravity="center"
                    android:maxLines="1" android:ellipsize="end" android:text="@string/widget_ellipsis" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="1dp"
            android:background="?android:attr/textColorSecondary" android:alpha="0.24" />
        <!-- Lower right: 5 daily forecasts -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/widget_material_you_forecast_week_1"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="?android:attr/textColorPrimary" android:gravity="center"
                    android:maxLines="1" android:ellipsize="end" android:text="@string/widget_ellipsis" />
                <ImageView android:id="@+id/widget_material_you_forecast_dayIcon_1"
                    android:layout_width="22dp" android:layout_height="22dp"
                    android:layout_marginTop="7dp" android:layout_marginBottom="7dp"
                    android:src="@drawable/weather_cloudy" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center">
                    <TextView android:id="@+id/widget_material_you_forecast_dayTemperature_1"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed-light"
                        android:textSize="11sp" android:textColor="?android:attr/textColorPrimary"
                        android:maxLines="1" android:text="@string/widget_ellipsis" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed-light"
                        android:id="@+id/widget_split_forecast_temp_separator_1" android:text="/" android:textSize="11sp" android:textColor="?android:attr/textColorSecondary" />
                    <TextView android:id="@+id/widget_material_you_forecast_nightTemperature_1"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed-light"
                        android:textSize="11sp" android:textColor="?android:attr/textColorSecondary"
                        android:maxLines="1" android:text="@string/widget_ellipsis" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/widget_material_you_forecast_week_2"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="?android:attr/textColorPrimary" android:gravity="center"
                    android:maxLines="1" android:ellipsize="end" android:text="@string/widget_ellipsis" />
                <ImageView android:id="@+id/widget_material_you_forecast_dayIcon_2"
                    android:layout_width="22dp" android:layout_height="22dp"
                    android:layout_marginTop="7dp" android:layout_marginBottom="7dp"
                    android:src="@drawable/weather_cloudy" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center">
                    <TextView android:id="@+id/widget_material_you_forecast_dayTemperature_2"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed-light"
                        android:textSize="11sp" android:textColor="?android:attr/textColorPrimary"
                        android:maxLines="1" android:text="@string/widget_ellipsis" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed-light"
                        android:id="@+id/widget_split_forecast_temp_separator_2" android:text="/" android:textSize="11sp" android:textColor="?android:attr/textColorSecondary" />
                    <TextView android:id="@+id/widget_material_you_forecast_nightTemperature_2"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed-light"
                        android:textSize="11sp" android:textColor="?android:attr/textColorSecondary"
                        android:maxLines="1" android:text="@string/widget_ellipsis" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/widget_material_you_forecast_week_3"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="?android:attr/textColorPrimary" android:gravity="center"
                    android:maxLines="1" android:ellipsize="end" android:text="@string/widget_ellipsis" />
                <ImageView android:id="@+id/widget_material_you_forecast_dayIcon_3"
                    android:layout_width="22dp" android:layout_height="22dp"
                    android:layout_marginTop="7dp" android:layout_marginBottom="7dp"
                    android:src="@drawable/weather_cloudy" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center">
                    <TextView android:id="@+id/widget_material_you_forecast_dayTemperature_3"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed-light"
                        android:textSize="11sp" android:textColor="?android:attr/textColorPrimary"
                        android:maxLines="1" android:text="@string/widget_ellipsis" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed-light"
                        android:id="@+id/widget_split_forecast_temp_separator_3" android:text="/" android:textSize="11sp" android:textColor="?android:attr/textColorSecondary" />
                    <TextView android:id="@+id/widget_material_you_forecast_nightTemperature_3"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed-light"
                        android:textSize="11sp" android:textColor="?android:attr/textColorSecondary"
                        android:maxLines="1" android:text="@string/widget_ellipsis" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/widget_material_you_forecast_week_4"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="?android:attr/textColorPrimary" android:gravity="center"
                    android:maxLines="1" android:ellipsize="end" android:text="@string/widget_ellipsis" />
                <ImageView android:id="@+id/widget_material_you_forecast_dayIcon_4"
                    android:layout_width="22dp" android:layout_height="22dp"
                    android:layout_marginTop="7dp" android:layout_marginBottom="7dp"
                    android:src="@drawable/weather_cloudy" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center">
                    <TextView android:id="@+id/widget_material_you_forecast_dayTemperature_4"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed-light"
                        android:textSize="11sp" android:textColor="?android:attr/textColorPrimary"
                        android:maxLines="1" android:text="@string/widget_ellipsis" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed-light"
                        android:id="@+id/widget_split_forecast_temp_separator_4" android:text="/" android:textSize="11sp" android:textColor="?android:attr/textColorSecondary" />
                    <TextView android:id="@+id/widget_material_you_forecast_nightTemperature_4"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed-light"
                        android:textSize="11sp" android:textColor="?android:attr/textColorSecondary"
                        android:maxLines="1" android:text="@string/widget_ellipsis" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/widget_material_you_forecast_week_5"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="?android:attr/textColorPrimary" android:gravity="center"
                    android:maxLines="1" android:ellipsize="end" android:text="@string/widget_ellipsis" />
                <ImageView android:id="@+id/widget_material_you_forecast_dayIcon_5"
                    android:layout_width="22dp" android:layout_height="22dp"
                    android:layout_marginTop="7dp" android:layout_marginBottom="7dp"
                    android:src="@drawable/weather_cloudy" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center">
                    <TextView android:id="@+id/widget_material_you_forecast_dayTemperature_5"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed-light"
                        android:textSize="11sp" android:textColor="?android:attr/textColorPrimary"
                        android:maxLines="1" android:text="@string/widget_ellipsis" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed-light"
                        android:id="@+id/widget_split_forecast_temp_separator_5" android:text="/" android:textSize="11sp" android:textColor="?android:attr/textColorSecondary" />
                    <TextView android:id="@+id/widget_material_you_forecast_nightTemperature_5"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed-light"
                        android:textSize="11sp" android:textColor="?android:attr/textColorSecondary"
                        android:maxLines="1" android:text="@string/widget_ellipsis" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
